# Copia este archivo como backend/.env y llénalo con tus datos locales. backend/.env nunca se sube.
# Formato de las URL: postgresql+psycopg://USUARIO:CLAVE@localhost:5432/NOMBRE_BASE

# Base que usa la aplicación (uvicorn y la carga del catálogo).
DATABASE_URL=

# Base vacía solo para pruebas: las pruebas borran y recrean sus tablas.
DATABASE_URL_PRUEBAS=

# Orígenes del navegador que pueden llamar a la API, separados por comas (ej. http://localhost:4200).
# Lista orígenes exactos; nunca uses «*».
ORIGENES_PERMITIDOS=
